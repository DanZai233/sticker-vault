{
  "name": "sticker-vault",
  "productName": "表情仓",
  "version": "0.6.0",
  "description": "本地表情素材管理器",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "package": "electron-builder --dir --publish never",
    "dist": "electron-builder",
    "prepare:helper": "node scripts/prepare-helper.cjs",
    "check": "node --check src/main.cjs && node --check src/renderer.js && node --check src/ocr.cjs && node --check src/ocr-host.cjs && node --check src/startup.cjs && npm test",
    "build:native": "node scripts/build-native.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:platform-ui": "electron scripts/test-platform-ui.cjs",
    "prepare:ocr": "node scripts/prepare-ocr.cjs",
    "test:ocr-engine": "electron scripts/test-ocr-engine.cjs",
    "test:backup-engine": "electron scripts/test-backup-engine.cjs",
    "test:desktop": "node scripts/test-desktop.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "prettier": "^3.10.1"
  },
  "author": {
    "name": "DanZai233",
    "email": "71169811+DanZai233@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanZai233/sticker-vault.git"
  },
  "desktopName": "stickervault",
  "dependencies": {
    "tesseract.js": "^7.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
